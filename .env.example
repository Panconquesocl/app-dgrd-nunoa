# Base de datos (Docker local — ver docker-compose.yml)
DATABASE_URL="postgresql://dgrd:dgrd@localhost:5432/dgrd_nunoa?schema=public"

# Conexión directa para la CLI de Prisma. Solo hace falta si DATABASE_URL pasa por un
# pooler (p. ej. el host "-pooler" de Neon), porque Prisma Migrate no funciona a través
# de PgBouncer. Con Docker déjala comentada: la CLI usa DATABASE_URL.
# DIRECT_URL="postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Better Auth
# Genera el secret con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Dominio institucional permitido para el acceso
ALLOWED_EMAIL_DOMAIN="nunoa.cl"

# Cuenta de administrador inicial (usada sólo por `pnpm db:seed`)
ADMIN_EMAIL="admin@nunoa.cl"
ADMIN_NAME="Administrador"
ADMIN_PASSWORD=""
